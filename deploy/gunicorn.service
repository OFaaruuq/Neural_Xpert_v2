[Unit]
Description=Neural Xpert Gunicorn
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/neuralxpert
EnvironmentFile=/var/www/neuralxpert/.env
Environment=FLASK_CONFIG=production
ExecStart=/var/www/neuralxpert/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
