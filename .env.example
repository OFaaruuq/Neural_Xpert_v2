FLASK_CONFIG=development
# Production refuses startup when SECRET_KEY is missing, shorter than 32 characters, or a placeholder.
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/neuralxpert
SITE_URL=https://neuralxpert.com

# Contact and career email. Leave MAIL_SERVER empty to store submissions without sending.
# MAIL_USE_TLS and MAIL_USE_SSL accept 1/0 or true/false. Gmail uses port 587 and TLS.
# MAIL_DEFAULT_SENDER may be a display name; the mailbox address is MAIL_USERNAME.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Neural Xpert
MAIL_DEFAULT_RECIPIENT=
CONTACT_RECIPIENT=

# Used only by: flask create-admin
# Replace ADMIN_PASSWORD before creating the production account. There is no public registration.
ADMIN_EMAIL=admin@neuralxpert.com
ADMIN_PASSWORD=change-me
