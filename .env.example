FLASK_CONFIG=development
# Production refuses startup when SECRET_KEY is missing, shorter than 32 characters, or a placeholder.
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/neuralxpert
SITE_URL=https://neuralxpert.com

# Optional contact notification. Leave MAIL_SERVER empty to store enquiries without sending.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=partnerships@neuralxpert.com
CONTACT_RECIPIENT=partnerships@neuralxpert.com

# Used only by: flask create-admin
# Replace ADMIN_PASSWORD before creating the production account. There is no public registration.
ADMIN_EMAIL=admin@neuralxpert.com
ADMIN_PASSWORD=change-me
